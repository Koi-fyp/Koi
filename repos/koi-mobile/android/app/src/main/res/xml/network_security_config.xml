<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext HTTP only to 127.0.0.1: the bundled avatar page served by
     lib/avatar/local_avatar_server.dart (KOI_AVATAR_URL=local). Everything
     else keeps the platform default (HTTPS only). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
