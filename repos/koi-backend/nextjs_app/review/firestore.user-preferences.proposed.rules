// REVIEW ONLY. Not configured for deployment. Replaces an expired public test grant, not ownership checks.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    function userFields() {
      return ['profile', 'onboarding_complete', 'public_crypto_metadata'];
    }
    function profileFields() {
      return ['avatar', 'companion', 'language', 'notificationTime'];
    }
    function validCreate() {
      let data = request.resource.data;
      return data.keys().hasOnly(userFields())
        && (!('profile' in data) || (data.profile is map && data.profile.keys().hasOnly(profileFields())))
        && (!('onboarding_complete' in data) || data.onboarding_complete is bool)
        && (!('public_crypto_metadata' in data) || (data.public_crypto_metadata is map
          && data.public_crypto_metadata.keys().hasOnly(['salt']) && data.public_crypto_metadata.salt is string));
    }
    function validUpdate() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return changed.hasOnly(userFields())
        && (!changed.hasAny(['profile']) || (data.profile is map
          && resource.data.get('profile', {}) is map
          && data.profile.diff(resource.data.get('profile', {})).affectedKeys().hasOnly(profileFields())))
        && (!changed.hasAny(['onboarding_complete']) || data.onboarding_complete is bool)
        && (!changed.hasAny(['public_crypto_metadata']) || (data.public_crypto_metadata is map
          && resource.data.get('public_crypto_metadata', {}) is map
          && data.public_crypto_metadata.diff(resource.data.get('public_crypto_metadata', {})).affectedKeys().hasOnly(['salt'])
          && data.public_crypto_metadata.salt is string));
    }
    match /users/{userId} {
      allow get: if owns(userId);
      allow create: if owns(userId) && validCreate();
      allow update: if owns(userId) && validUpdate();
      allow list, delete: if false;
    }
    // No new access for chat, clinical/activity data, queues or any other collection.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
