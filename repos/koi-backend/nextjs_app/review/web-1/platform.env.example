# Local WEB-1 demo only. Do not paste real credentials into this file.
KOI_PLATFORM_MODE=emulator
KOI_PLATFORM_FIREBASE_PROJECT_ID=demo-koi-platform-web1
FIRESTORE_EMULATOR_HOST=127.0.0.1:5180
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:5199
NEXT_PUBLIC_KOI_PLATFORM_FIREBASE_PROJECT_ID=demo-koi-platform-web1
NEXT_PUBLIC_KOI_PLATFORM_AUTH_EMULATOR_URL=http://127.0.0.1:5199

# Restricted CLI only; configure an existing operator UID privately.
KOI_PLATFORM_BOOTSTRAP_ADMIN_UID=
KOI_PLATFORM_BOOTSTRAP_SERVICE_ACCOUNT=emulator-only

# Reviewed production names ONLY, not enabled by this example:
# KOI_PLATFORM_MODE=reviewed-production
# KOI_PLATFORM_FIREBASE_PROJECT_ID=
# KOI_PLATFORM_RULESET_SHA256=
# KOI_PLATFORM_CURSOR_SIGNING_KEY=
# KOI_PLATFORM_BOOTSTRAP_SERVICE_ACCOUNT=
# FIREBASE_ADMIN_SDK=
# Never put Admin credentials/cursor keys in NEXT_PUBLIC_* variables.
